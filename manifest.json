{
  "manifest_version": 3,
  "name": "Discord Chat Exporter",
  "description": "Save a Discord conversation as a readable HTML, Markdown, or JSON file.",
  "version": "2.0.0",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_title": "Export Discord chat", "default_icon": {"128": "icons/logo.png"}},
  "background": {"service_worker": "js/background.js"},
  "icons": {"128": "icons/logo.png"},
  "key": ""
}
